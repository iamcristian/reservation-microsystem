// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BusinessSettings {
  id                     Int      @id @default(1)
  name                   String   @default("Mi Negocio")
  tagline                String   @default("Reserva tu cita en segundos")
  logoUrl                String?
  addressText            String   @default("Av. Principal 123, Bolivia")
  googleMapsUrl          String   @default("https://maps.google.com")
  phoneWhatsapp          String   @default("+59170000000")
  currencySymbol         String   @default("Bs")
  staffLabel             String   @default("Especialista") // Dynamic terminology: "Especialista" | "Doctor(a)" | "Barbero"
  slotStepMin            Int      @default(30)            // Grid interval: 15, 20, 30 min
  bookingHorizonDays     Int      @default(7)             // Booking horizon limit (e.g. 7 days ahead)
  minLeadTimeMinutes     Int      @default(30)            // Minimum lead time before appointment start
  maxActiveBookings      Int      @default(2)             // Anti-hoarding limit: max active upcoming bookings
  minCancelNoticeHours   Int      @default(6)             // Advance notice required for customer cancellation
  themePrimaryHex        String   @default("#1F1F23")     // Primary theme brand color
  themeSurfaceHex        String   @default("#9FA0A6")     // Secondary surface color
  updatedAt              DateTime @updatedAt
}

model User {
  id             String         @id @default(cuid())
  googleId       String?        @unique
  email          String         @unique
  passwordHash   String?        // Bcrypt-hashed password for secure email login
  name           String
  avatarUrl      String?
  phone          String?        // Required contact phone number
  role           String         @default("CUSTOMER") // "CUSTOMER" | "PROVIDER" | "ADMIN"
  isBlocked     Boolean        @default(false)      // Anti-troll lock: blocked due to no-shows
  noShowCount   Int            @default(0)
  completedCount Int           @default(0)
  adminNotes    String?
  createdAt     DateTime       @default(now())

  staffProfile  StaffProfile?
  appointments  Appointment[]
  notifications Notification[]
}

model StaffProfile {
  id                  String         @id @default(cuid())
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id])
  displayName         String
  specialtyTitle      String         @default("Especialista")
  avatarUrl           String?
  customHorizonDays   Int?           // Specialist custom horizon override (days)
  customLeadTimeMin   Int?           // Specialist custom lead time override (minutes)
  isActive            Boolean        @default(true)
  sortOrder           Int            @default(0)

  services            StaffService[]
  workingShifts       WorkingShift[]
  timeOffs            TimeOff[]
  appointments        Appointment[]
}

model Service {
  id             String         @id @default(cuid())
  name           String
  description    String?
  durationMin    Int            @default(30) // Duration: 15, 30, 45, 60, 90 min
  bufferAfterMin Int            @default(0)  // Turnaround buffer time post-appointment
  price          Float          @default(25.0)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)

  staff          StaffService[]
  appointments   Appointment[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingShift {
  id        String       @id @default(cuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int          // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTime String       // Format "HH:mm" (e.g. "07:00", "14:30", "01:00")
  endTime   String       // Format "HH:mm" (e.g. "13:00", "19:30", "06:00")

  @@index([staffId, dayOfWeek])
}

model TimeOff {
  id        String       @id @default(cuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  type      String       @default("CUSTOM_BLOCK") // "LATE_START" | "EARLY_LEAVE" | "FULL_DAY_OFF" | "CUSTOM_BLOCK"
  reason    String?      // Contextual reason e.g. "Medical Emergency", "Conference"
  createdAt DateTime     @default(now())

  @@index([staffId, startAt, endAt])
}

model Appointment {
  id                  String       @id @default(cuid())
  customerId          String
  customer            User         @relation(fields: [customerId], references: [id])
  staffId             String
  staff               StaffProfile @relation(fields: [staffId], references: [id])
  serviceId           String
  service             Service      @relation(fields: [serviceId], references: [id])

  startAt             DateTime
  endAt               DateTime     // startAt + durationMin + bufferAfterMin
  status              String       @default("CONFIRMED") 
  // Statuses: "CONFIRMED" | "RESCHEDULED_BY_STAFF" | "COMPLETED" | "CANCELLED" | "NO_SHOW"

  previousStartAt     DateTime?    // Original timestamp if rescheduled by staff
  staffMoveReason     String?      // Operational note explaining rescheduling
  allowFreeCancel     Boolean      @default(false) // Penalty-free cancel if modified by staff

  priceSnapshot       Float
  customerNotes       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([staffId, startAt, endAt])
  @@index([customerId, status, startAt])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?
  title         String
  message       String
  type          String   // "APPOINTMENT_MOVED" | "APPOINTMENT_CANCELLED" | "REMINDER"
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, isRead])
}
