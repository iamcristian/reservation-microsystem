# Local SQLite database (default for rapid development)
DATABASE_URL="file:./dev.db"

# Cryptographic HMAC-SHA256 secret used to sign session cookies (Generate with: openssl rand -hex 32)
SESSION_SECRET="replace-with-a-32-byte-random-hex-secret-in-production"

# Google OAuth 2.0 Credentials (https://console.cloud.google.com)
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
